# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/
*_files/


# Quarto files
.quarto/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# pkgdown site
docs/

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/

# Do not track big ome data (added by trainomeMetaData)
/ome-data/
# Do not track simulation results or other large files
data_sim/
data_sim-*/
/analysis/data/raw_data/
/analysis/data/derived_data/
/analysis/archive/

# The same results directories, but at the repository root. They belong under
# analysis/data/derived_data/ and are ignored there by the rule above; a script
# run with a different working directory writes them here instead, where no
# rule covered them. That is how 321 MB of shrinkage output reached a commit.
# The patterns are anchored to the root, so the real directories are unaffected.
/full_v*/
/permutation_v*/
/shrinkage_v*/
/timing_v*/
/timing_smoketest/
/normalization_check/
/published_anova/
/temp-make-logs/

# Keep manuscript output
!analysis/tracked-archive/paper.pdf
!analysis/paper/supplement.pdf

analysis/figures/*.RDS



# Do not track PDFs
*.pdf

# do not track .docx
*.docx

.positai
.claude/


.Rproj.user
